{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "nix develop -c xpg build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "format",
      "type": "shell",
      "command": "nix develop -c format",
      "problemMatcher": []
    },
    {
      "label": "format-check",
      "type": "shell",
      "command": "nix develop -c format-check",
      "problemMatcher": []
    },
    {
      "label": "psql",
      "type": "shell",
      "command": "nix develop -c xpg psql",
      "problemMatcher": []
    }
  ]
}
